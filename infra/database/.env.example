# 复制为服务器同目录的 .env；真实 .env 含密码，绝不提交 Git。
# 共享开发数据库名称：DataGrip 和 Prisma 都连接此名称。
MYSQL_DATABASE=pixel_town_dev
# 项目日常连接账号：不要使用 root 作为应用或 DataGrip 日常账号。
MYSQL_USER=pixel_dev
# 项目日常连接密码：在服务器用 openssl rand -hex 24 生成。
MYSQL_PASSWORD=replace-with-a-long-random-password
# MySQL 管理/备份密码：用与上面不同的 openssl rand -hex 32 生成。
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
