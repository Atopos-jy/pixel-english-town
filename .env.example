# ==================== 数据库 ====================
# MySQL（通过 SSH 隧道连接服务器时使用本机 13306 端口）
DATABASE_URL="mysql://pixel_town:replace-with-password@127.0.0.1:13306/pixel_town"

# ==================== 认证 ====================
# JWT 签名密钥；至少 32 位，由 Fastify、Next.js 服务端校验与 Socket.IO 读取
JWT_SECRET="replace-with-a-separate-32-character-or-longer-secret"
# AES-256-GCM 密钥（Base64 编码的 32 字节随机值），用于加密用户保存的 AI API Key
AI_SETTINGS_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
# 广场内部接口认证密钥；Socket.IO 请求 Fastify 内部接口时使用
PLAZA_INTERNAL_SECRET="replace-with-an-independent-long-random-secret"

# ==================== 前端 ====================
# Fastify API 地址（Next.js rewrites 代理目标）
API_ORIGIN="http://localhost:4000"
# 前端访问地址（CORS 用）
WEB_ORIGIN="http://localhost:3000"
# 客户端 Socket.IO 连接地址（浏览器使用，必须是 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# ==================== Socket.IO 实时服务 ====================
# Socket.IO 监听端口
SOCKET_IO_PORT="3001"
# Redis 连接地址（广场实时功能强依赖）
REDIS_URL="redis://127.0.0.1:16379"
# Socket.IO 允许的浏览器来源
SOCKET_CORS_ORIGINS="http://localhost:3000"

# ==================== 第三方服务 ====================
# Deepgram 语音转写 API Key
DEEPGRAM_API_KEY=""
# 阿里云 OSS（不上传音频可留空）
OSS_SECRET_ID=""
OSS_SECRET_KEY=""
OSS_BUCKET=""
OSS_REGION=""
OSS_PUBLIC_BASE_URL=""
