# ==================== 数据库 ====================
# MySQL（通过 SSH 隧道连接服务器时使用本机 13306 端口）
DATABASE_URL="mysql://pixel_town:replace-with-password@127.0.0.1:13306/pixel_town"

# ==================== Authentication ====================
# NextAuth 配置：本地开发时 Next.js 默认运行在 3000 端口
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Socket.IO 调用 Next.js 广场内部接口的服务端密钥，不发送给浏览器。
# 本地开发未配置时暂时回退使用 NEXTAUTH_SECRET；生产环境必须独立配置。
PLAZA_INTERNAL_SECRET="replace-with-an-independent-long-random-secret"

# ==================== Socket.IO 广场实时服务 ====================
# Socket.IO 服务监听端口（服务端使用，pnpm socket 启动的进程）
SOCKET_IO_PORT="3001"
# 客户端连接 Socket.IO 的地址（浏览器使用，必须是 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
# Redis 连接地址。Socket.IO 服务强依赖 Redis 做在线状态管理，必须先启动 Redis。
# 本项目本地通过 SSH 隧道连接远程 Redis 时使用 16379 端口。
# 如改用本地 Docker Redis，请改为 redis://127.0.0.1:6379。
REDIS_URL="redis://127.0.0.1:16379"
# Socket.IO 允许的浏览器来源，多个来源用英文逗号分隔；生产环境必须填写实际 HTTPS 域名。
SOCKET_CORS_ORIGINS="http://localhost:3000"

# 可选服务：未配置时保持为空。
GROQ_API_KEY=""
# 阿里云 OSS 的 RAM 用户 AccessKey；只在服务端读取，严禁使用 NEXT_PUBLIC_ 前缀。
OSS_SECRET_ID=""
OSS_SECRET_KEY=""
# OSS Bucket 名称与地域，例如 pixel-english-town、oss-cn-hangzhou。
OSS_BUCKET=""
OSS_REGION=""
# 可选：公开访问域名（例如 https://bucket.oss-cn-hangzhou.aliyuncs.com）。
# 未填写时，服务端按 Bucket 与 Region 自动生成 HTTPS 地址。
OSS_PUBLIC_BASE_URL=""
