# ==================== 生产环境变量模板 ====================
# 复制为 .env.production：cp .env.production.example .env.production

# 数据库 —— Docker 容器名 mysql-pixel
DATABASE_URL="mysql://pixel_town:你的数据库密码@mysql-pixel:3306/pixel_town"

# Redis —— Docker 容器名 redis
REDIS_URL="redis://redis:6379"

# JWT 签名密钥 —— 从本地 .env 复制，或生成新的随机字符串（至少 32 位）
JWT_SECRET="从本地.env复制过来"

# AI 设置加密密钥 —— 从本地 .env 复制
AI_SETTINGS_ENCRYPTION_KEY="从本地.env复制过来"

# 广场内部接口认证 —— 填一个新的随机字符串
PLAZA_INTERNAL_SECRET="生成一个独立的高强度随机字符串"

# Deepgram 语音转写 API Key
DEEPGRAM_API_KEY="你的Deepgram API Key"

# 前端访问地址（用实际服务器 IP 或域名）
WEB_ORIGIN="http://你的服务器IP:3000"

# 浏览器连接 Socket.IO 的地址
NEXT_PUBLIC_SOCKET_URL="http://你的服务器IP:3001"

# Socket.IO CORS 允许来源（与 WEB_ORIGIN 一致，多个用英文逗号分隔）
SOCKET_CORS_ORIGINS="http://你的服务器IP:3000"

# 阿里云 OSS（不上传音频可留空）
OSS_SECRET_ID=""
OSS_SECRET_KEY=""
OSS_BUCKET=""
OSS_REGION=""
OSS_PUBLIC_BASE_URL=""
