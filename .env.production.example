# ==================== 生产环境变量模板 ====================
# 复制此文件为 .env.production 并填入真实值

# 数据库 —— 指向服务器上已有的 MySQL 容器/实例
DATABASE_URL="mysql://pixel_town:你的密码@mysql:3306/pixel_town"

# Redis —— 指向服务器上已有的 Redis 容器/实例
REDIS_URL="redis://redis:6379"

# JWT 签名密钥（至少 32 位随机字符串）
JWT_SECRET="生产环境高强度随机字符串-至少32位"

# AI 设置加密密钥（Base64 编码的 32 字节随机值）
AI_SETTINGS_ENCRYPTION_KEY="生产环境Base64编码的32字节密钥"

# 广场内部接口认证密钥
PLAZA_INTERNAL_SECRET="生产环境独立随机字符串"

# Deepgram 语音转写 API Key
DEEPGRAM_API_KEY="你的Deepgram API Key"

# 前端域名（用于 CORS）
WEB_ORIGIN="https://你的域名或http://服务器IP:3000"

# Socket.IO 客户端连接地址
NEXT_PUBLIC_SOCKET_URL="https://你的域名:3001或http://服务器IP:3001"

# Socket.IO CORS 允许来源
SOCKET_CORS_ORIGINS="https://你的域名,http://服务器IP:3000"

# 阿里云 OSS（可选，不上传音频可不填）
OSS_SECRET_ID=""
OSS_SECRET_KEY=""
OSS_BUCKET=""
OSS_REGION=""
OSS_PUBLIC_BASE_URL=""
