// Prisma Schema 配置文件
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id        String        @id @default(cuid())
  email     String        @unique
  password  String
  name      String?
  role      String        @default("user") // 用户角色：user 或 admin
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  // 关联用户进度（一对一关系）
  progress  UserProgress?
  aiSetting UserAiSetting?
  articleCompletions ArticleCompletion[]
  plazaActivities PlazaActivity[]
  
  @@map("users")
}

// 用户进度模型（存储用户的学习统计和完成记录）
model UserAiSetting {
  id              String   @id @default(cuid())
  userId          String   @unique
  provider        String
  selectedModel   String
  encryptedApiKey String   @db.Text
  apiKeyLast4     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ai_settings")
}

model UserProgress {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  
  // 完成的文章ID列表
  completedArticleIds     Json     @default("[]")
  
  // 统计数据
  totalDaysLearned        Int      @default(0)
  totalArticlesCompleted  Int      @default(0)
  currentStreak           Int      @default(0)
  longestStreak           Int      @default(0)
  
  // 按难度统计
  beginnerCount           Int      @default(0)
  intermediateCount       Int      @default(0)
  advancedCount           Int      @default(0)
  
  // 最后完成日期
  lastCompletedDate       String?
  
  // 活动日志（日期 -> 完成数量）
  activityLog             Json     @default("{}")
  
  // 徽章列表
  badges                  Json     @default("[]")
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // 关联用户
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_progress")
}

// 文章模型
model Article {
  id              String   @id
  date            String
  titleEn         String   @db.Text
  titleZh         String   @db.Text
  summaryEn       String   @db.Text
  summaryZh       String   @db.Text
  content         Json
  difficulty      String
  durationSeconds Int
  audioUrl        String?  @db.Text
  wordTimestamps  Json?    // 逐词时间戳 [{word, start, end}]，由 Whisper API 生成
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completions     ArticleCompletion[]
  
  @@map("articles")
}

model ArticleCompletion {
  id           String   @id @default(cuid())
  userId       String
  articleId    String
  learningDate String
  completedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([learningDate, completedAt])
  @@map("article_completions")
}

enum PlazaActivityType {
  ENTER_PLAZA
  ARTICLE_COMPLETED
  BADGE_EARNED
}

model PlazaActivity {
  id        String            @id @default(cuid())
  userId    String
  type      PlazaActivityType
  content   String            @db.VarChar(500)
  metadata  Json?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("plaza_activities")
}

// 文章公开编号序列：在事务中递增，保证并发新建时 art-xxx 不会重复。
model ArticleIdSequence {
  name         String   @id
  currentValue Int
  updatedAt    DateTime @updatedAt

  @@map("article_id_sequences")
}

model BadgeConfig {
  id        String   @id
  badges    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("badge_configs")
}
